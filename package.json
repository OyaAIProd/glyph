{
  "name": "glyph-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "A chart is a query is a chart. Grammar of graphics with DuckDB inside, designed for AI agents.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/seanhanca/glyph.git"
  },
  "homepage": "https://github.com/seanhanca/glyph",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "build:playground": "pnpm --filter @glyph/core run build && node scripts/build-playground-bundle.mjs",
    "test": "pnpm -r --filter './packages/*' run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --filter './packages/*' exec tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.7.5",
    "@types/three": "0.169.0",
    "esbuild": "^0.24.0",
    "three": "0.169.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
