{
  "data": {
    "source": "./sales.csv",
    "format": "csv",
    "transform": "SELECT quarter, revenue FROM glyph_src_main ORDER BY quarter"
  },
  "layers": [
    {
      "mark": "bar",
      "encoding": {
        "x": "quarter",
        "y": { "field": "revenue", "scale": { "domain": [100, 160] } }
      }
    }
  ],
  "title": "Quarterly revenue"
}
